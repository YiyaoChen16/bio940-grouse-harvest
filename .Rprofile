  RENV_PATHS_CACHE = file.path(getwd(), "renv/cache"),
  RENV_PATHS_SANDBOX = file.path(getwd(), "renv/sandbox"),
  RENV_CONFIG_CACHE_SYMLINKS = "FALSE"
)
source("renv/activate.R")
